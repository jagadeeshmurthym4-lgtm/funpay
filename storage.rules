rules_version = '2';

// Firebase Storage Security Rules
// Bucket: cashspark-c15bd.firebasestorage.app
//
// As of July 2026, QR code uploads have been migrated to Cloudinary.
// Firebase Storage is no longer actively used by the app.
//
// These rules deny all access by default. If a future feature needs
// Firebase Storage, update this file and add the appropriate rules.

service firebase.storage {
  match /b/{bucket}/o {
    // Deny all operations — Storage is not actively used.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
