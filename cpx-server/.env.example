# ── CPX Research postback server env vars ─────────────────────────

# Postback verification secret — MUST match the "secure hash" configured in
# your CPX publisher dashboard (Postback Settings). Used to verify {hash}.
CPX_SECRET=REPLACE_WITH_YOUR_CPX_SECURE_HASH

# "true" → skip hash verification ENTIRELY and accept postbacks even when no
# (or an invalid) hash is sent. Use this while the CPX account does not have
# "secure hash" enabled in the publisher dashboard. When CPX starts sending
# valid hashes, set this back to "false" and full verification is re-enabled
# automatically.
CPX_ALLOW_UNSIGNED=true

# Firebase Admin credentials — EITHER a JSON string of the service account:
FIREBASE_SERVICE_ACCOUNT=
# OR the path to a service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Port (Render sets this automatically):
# PORT=3001
